/* Mobile Single Video Display Fix */

// Hide multiple videos on mobile - only show active video
@media (max-width: 768px) {
  .shorts-page-container {
    overflow-x: hidden; // Prevent horizontal scroll
  }
  
  .shorts-content {
    padding: 10px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: calc(100vh - 120px);
  }
  
  .shorts-carousel-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }
  
  .shorts-carousel-container {
    padding: 0;
    width: 100%;
    max-width: none;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }
  
  .shorts-carousel {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    overflow: hidden;
  }
  
  .shorts-track {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0;
    width: 100%;
    transform: none !important; // Override transform for mobile
    transition: none !important; // Disable transitions
  }
  
  .short-card {
    flex: 0 0 90vw;
    max-width: 350px;
    height: calc(90vw * 1.78);
    max-height: 70vh;
    border-radius: 20px;
    margin: 0 auto;
    position: relative;
    
    // Hide all cards except active one
    &:not(.active) {
      display: none !important;
    }
    
    // Ensure active card is fully visible and centered
    &.active {
      display: flex !important;
      flex-direction: column;
      position: relative;
      z-index: 10;
    }
    
    .short-video-container {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      border-top-left-radius: 18px;
      border-top-right-radius: 18px;
      overflow: hidden;
      background: #000;
    }
    
    .short-video,
    .short-thumbnail {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      display: block;
    }
    
    .mona-card-footer {
      flex-shrink: 0;
      min-height: 80px;
      padding: 20px 20px 15px;
      background: $card-bg;
      border-bottom-left-radius: 18px;
      border-bottom-right-radius: 18px;
      margin-top: 0;
      position: relative;
      z-index: 10;
      
      .card-text {
        font-size: 16px;
        line-height: 1.4;
        color: #ffffff;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        text-overflow: ellipsis;
      }
    }
  }
  
  // Hide navigation arrows on mobile
  .carousel-arrow {
    display: none !important;
  }
  
  // Adjust dots for mobile
  .carousel-dots {
    margin-top: 20px;
    gap: 10px;
    
    .dot {
      width: 8px;
      height: 8px;
    }
  }
}

// Smaller mobile devices
@media (max-width: 480px) {
  .shorts-content {
    padding: 5px 0;
    min-height: calc(100vh - 100px);
  }
  
  .short-card {
    flex: 0 0 95vw;
    max-width: 320px;
    height: calc(95vw * 1.78);
    max-height: 65vh;
    border-radius: 15px;
    
    .short-video-container {
      border-top-left-radius: 13px;
      border-top-right-radius: 13px;
    }
    
    .mona-card-footer {
      min-height: 70px;
      padding: 15px 15px 10px;
      border-bottom-left-radius: 13px;
      border-bottom-right-radius: 13px;
      
      .card-text {
        font-size: 15px;
        -webkit-line-clamp: 2;
      }
    }
  }
}

// Very small devices
@media (max-width: 360px) {
  .short-card {
    flex: 0 0 98vw;
    max-width: 300px;
    height: calc(98vw * 1.78);
    max-height: 60vh;
    border-radius: 12px;
    
    .short-video-container {
      border-top-left-radius: 10px;
      border-top-right-radius: 10px;
    }
    
    .mona-card-footer {
      min-height: 60px;
      padding: 12px 12px 8px;
      border-bottom-left-radius: 10px;
      border-bottom-right-radius: 10px;
      
      .card-text {
        font-size: 14px;
        -webkit-line-clamp: 2;
      }
    }
  }
}

// Landscape orientation on mobile
@media (max-height: 500px) and (orientation: landscape) {
  .shorts-content {
    padding: 5px 0;
    min-height: calc(100vh - 80px);
  }
  
  .short-card {
    height: 80vh;
    max-height: 400px;
    
    .mona-card-footer {
      min-height: 50px;
      padding: 10px 15px 8px;
      
      .card-text {
        font-size: 14px;
        -webkit-line-clamp: 1;
      }
    }
  }
}

// Fix for iOS Safari viewport issues
@supports (-webkit-touch-callout: none) {
  @media (max-width: 768px) {
    .shorts-page-container {
      min-height: -webkit-fill-available;
    }
    
    .shorts-content {
      min-height: calc(-webkit-fill-available - 120px);
    }
  }
}

// Disable swipe gestures that might interfere
@media (max-width: 768px) {
  .shorts-track {
    touch-action: none !important;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  
  .short-card {
    touch-action: manipulation;
  }
}

// Loading state for mobile
@media (max-width: 768px) {
  .video-loading {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 20;
    
    .loading-spinner {
      width: 40px;
      height: 40px;
      border-width: 3px;
    }
    
    p {
      font-size: 14px;
      margin-top: 10px;
      color: #ffffff;
    }
  }
}
