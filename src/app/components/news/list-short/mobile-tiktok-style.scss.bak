/* Mobile TikTok-like Layout */

@media (max-width: 768px) {
  .shorts-page-container {
    background: #000;
    overflow: hidden;
    position: relative;
  }
  
  .mona-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: transparent;
    backdrop-filter: none;
    border-bottom: none;
    padding: calc(env(safe-area-inset-top, 0) + 15px) 20px 15px;
    box-shadow: none;
    justify-content: flex-start;
    
    .header-left {
      .mona-logo {
        display: flex;
        align-items: center;
        gap: 6px;
        
        .logo-text {
          font-size: 16px;
          font-weight: 700;
          color: #ffffff;
          text-shadow: 0 2px 4px rgba(0,0,0,0.8);
          letter-spacing: 0.5px;
        }
        
        .bi-share {
          font-size: 14px;
          color: #ffffff;
          opacity: 0.8;
          cursor: pointer;
          transition: opacity 0.3s ease;
          text-shadow: 0 2px 4px rgba(0,0,0,0.8);
          
          &:hover {
            opacity: 1;
          }
        }
      }
    }
    
    .header-right {
      position: absolute;
      top: calc(env(safe-area-inset-top, 0) + 15px);
      right: 20px;
      
      .close-button {
        background: rgba(0,0,0,0.5);
        border: none;
        color: #ffffff;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        
        &:hover {
          background: rgba(255,255,255,0.2);
          transform: none;
        }
        
        i {
          font-size: 18px;
        }
      }
    }
  }
  
  .shorts-content {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0;
    margin: 0;
    min-height: 100vh;
    min-height: -webkit-fill-available;
    display: flex;
    flex-direction: column;
  }
  
  .shorts-carousel-wrapper {
    flex: 1;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .shorts-carousel-container {
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .shorts-carousel {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .shorts-track {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    transform: none !important;
  }
  
  .short-card {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    border-radius: 0;
    margin: 0;
    display: none;
    
    &.active {
      display: flex !important;
      flex-direction: column;
    }
    
    .short-video-container {
      flex: 1;
      width: 100%;
      height: 100%;
      position: relative;
      background: #000;
      border-radius: 0;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .short-video,
    .short-thumbnail {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      border-radius: 0;
    }
    
    .mona-card-footer {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.3) 30%, rgba(0,0,0,0.8) 100%);
      padding: 60px 20px 20px;
      margin: 0;
      min-height: auto;
      border-radius: 0;
      z-index: 10;
      
      .card-text {
        color: #ffffff;
        font-size: 16px;
        font-weight: 600;
        line-height: 1.4;
        text-shadow: 0 1px 3px rgba(0,0,0,0.8);
        margin: 0;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
      }
    }
  }
  
  // Side navigation controls (TikTok style)
  .mobile-side-controls {
    position: fixed;
    right: 15px;
    bottom: 120px;
    z-index: 100;
    display: flex;
    flex-direction: column;
    gap: 20px;
    
    .side-control-btn {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: rgba(0,0,0,0.4);
      border: none;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      transition: all 0.3s ease;
      
      &:active {
        transform: scale(0.9);
        background: rgba(255,255,255,0.2);
      }
      
      &.disabled {
        opacity: 0.3;
        cursor: not-allowed;
      }
    }
  }
  
  // Bottom navigation
  .mobile-bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: linear-gradient(0deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.4) 70%, transparent 100%);
    padding: 20px 20px calc(env(safe-area-inset-bottom, 0) + 20px);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 30px;
    
    .nav-btn {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: rgba(255,255,255,0.1);
      border: 2px solid rgba(255,255,255,0.2);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      transition: all 0.3s ease;
      
      &:active {
        transform: scale(0.9);
        background: rgba(255,255,255,0.2);
      }
      
      &.disabled {
        opacity: 0.3;
        cursor: not-allowed;
      }
    }
    
    .video-info {
      flex: 1;
      text-align: center;
      color: #ffffff;
      font-size: 14px;
      text-shadow: 0 1px 3px rgba(0,0,0,0.8);
      
      .counter {
        font-weight: 600;
        margin-bottom: 4px;
      }
      
      .dots {
        display: flex;
        justify-content: center;
        gap: 6px;
        
        .dot {
          width: 6px;
          height: 6px;
          border-radius: 50%;
          background: rgba(255,255,255,0.4);
          transition: all 0.3s ease;
          
          &.active {
            background: #ffffff;
            transform: scale(1.3);
          }
        }
      }
    }
  }
  
  // Hide desktop elements
  .carousel-arrow {
    display: none !important;
  }
  
  .carousel-dots {
    display: none !important;
  }
  
  .mobile-nav-buttons {
    display: none !important;
  }
}

// Portrait orientation optimization
@media (max-width: 768px) and (orientation: portrait) {
  .short-video,
  .short-thumbnail {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }
}

// Landscape orientation optimization
@media (max-width: 768px) and (orientation: landscape) {
  .mona-header {
    padding: 10px 20px;
  }
  
  .mobile-side-controls {
    bottom: 80px;
    right: 20px;
  }
  
  .mobile-bottom-nav {
    padding: 15px 20px 15px;
  }
  
  .short-card .mona-card-footer {
    padding: 40px 20px 15px;
  }
}

// Small mobile devices (480px)
@media (max-width: 480px) {
  .mona-header {
    padding: calc(env(safe-area-inset-top, 0) + 13px) 18px 13px;
    
    .header-left {
      .mona-logo {
        gap: 5px;
        
        .logo-text {
          font-size: 15px;
          letter-spacing: 0.4px;
        }
        
        .bi-share {
          font-size: 13px;
        }
      }
    }
    
    .header-right {
      top: calc(env(safe-area-inset-top, 0) + 13px);
      right: 18px;
      
      .close-button {
        width: 34px;
        height: 34px;
        
        i {
          font-size: 17px;
        }
      }
    }
  }
}

// Very small screens
@media (max-width: 360px) {
  .mona-header {
    padding: calc(env(safe-area-inset-top, 0) + 12px) 15px 12px;
    
    .header-left {
      .mona-logo {
        gap: 5px;
        
        .logo-text {
          font-size: 14px;
          letter-spacing: 0.3px;
        }
        
        .bi-share {
          font-size: 12px;
        }
      }
    }
    
    .header-right {
      top: calc(env(safe-area-inset-top, 0) + 12px);
      right: 15px;
      
      .close-button {
        width: 32px;
        height: 32px;
        
        i {
          font-size: 16px;
        }
      }
    }
  }
  
  .mobile-side-controls {
    right: 10px;
    gap: 15px;
    
    .side-control-btn {
      width: 45px;
      height: 45px;
      font-size: 18px;
    }
  }
  
  .mobile-bottom-nav {
    padding: 15px 15px calc(env(safe-area-inset-bottom, 0) + 15px);
    gap: 20px;
    
    .nav-btn {
      width: 45px;
      height: 45px;
      font-size: 18px;
    }
  }
}

// iOS Safari specific fixes
@supports (-webkit-touch-callout: none) {
  @media (max-width: 768px) {
    .shorts-page-container {
      min-height: -webkit-fill-available;
    }
    
    .shorts-content {
      min-height: -webkit-fill-available;
    }
  }
}

// Hide loading on mobile fullscreen
@media (max-width: 768px) {
  .loading-container {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(0,0,0,0.8);
    padding: 30px;
    border-radius: 10px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
}
